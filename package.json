{
  "name": "cascade",
  "private": true,
  "version": "0.1.0",
  "description": "Get paid in crypto from any blockchain and receive US dollars. Send, split and run team payroll with no fees for your users. Built on NEAR.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "demo": "tsx scripts/demo-sandbox.ts",
    "test": "pnpm test:unit && pnpm test:sandbox",
    "test:unit": "vitest run --project unit",
    "test:sandbox": "vitest run --project sandbox",
    "test:contracts": "cd contracts && cargo test",
    "build:contracts": "bash scripts/build-contracts.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx scripts/dev-sandbox.ts",
    "test:e2e": "node scripts/e2e/checkout.e2e.cjs",
    "deploy:cascade": "tsx scripts/mainnet/deploy.ts",
    "spike": "tsx scripts/mainnet/spike.ts",
    "agent": "tsx scripts/agent-demo.ts",
    "backend": "tsx services/server/src/main.ts",
    "demo-merchant": "tsx scripts/mainnet/demo-merchant.ts",
    "dev:static": "tsx scripts/dev-sandbox.ts --static",
    "worker:local": "tsx scripts/cloudflare/local.ts",
    "cf:configure": "tsx scripts/cloudflare/configure.ts",
    "cf:deploy": "bash scripts/cloudflare/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "near-api-js": "7.4.0",
    "near-sandbox": "0.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@cascade/core": "workspace:*",
    "@cascade/db": "workspace:*",
    "@cascade/engine": "workspace:*",
    "@cascade/near": "workspace:*",
    "@cascade/oneclick": "workspace:*",
    "@cascade/sputnik": "workspace:*",
    "@cascade/relayer": "workspace:*",
    "@cascade/settler": "workspace:*",
    "@cascade/api": "workspace:*",
    "@cascade/sdk": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@cascade/platform": "workspace:*",
    "hono": "4.12.34"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
