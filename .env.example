# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# `pnpm demo`, `pnpm dev` and `pnpm test` need NONE of these.
# Step-by-step: docs/mainnet-runbook.md

# testnet first, then mainnet
NEAR_NETWORK=testnet
# NEAR_RPC_URL=            # optional; defaults to FastNEAR's free RPC for the network

# The account that hosts Cascade (you create it in a wallet; scripts never create it).
# Names become <name>.<root>, the app contract becomes app.<root>.
CASCADE_ROOT_ID=
CASCADE_ROOT_PRIVATE_KEY=

# Created for you by `pnpm deploy:cascade` if left empty (keys are appended here).
# RELAYER_ACCOUNT_ID=
# RELAYER_PRIVATE_KEY=
# SETTLER_ACCOUNT_ID=
# SETTLER_PRIVATE_KEY=

# mainnet: real USDC. testnet: leave empty and the mock token is deployed.
# USDC_CONTRACT_ID=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# SPUTNIK_FACTORY_ID=sputnik-dao.near
# FACTORY_DAILY_CAP=50

# 1Click partner JWT from https://partners.near-intents.org (server only).
# Without it 1Click adds an app fee (we saw 1-20 bps) and refuses confidential quotes.
ONECLICK_JWT=

# For `pnpm spike outgoing|private`: a NEAR account of yours holding a few USDC.
SPIKE_ACCOUNT_ID=
SPIKE_PRIVATE_KEY=

# Backend (pnpm backend). Contract ids come from deployments/<network>.json;
# set these only to override. Full table: docs/hosting.md
# CASCADE_APP_ID=
# CASCADE_FACTORY_ID=
CASCADE_PUBLIC_URL=http://localhost:3000
# CASCADE_ALLOW_ORIGINS=           # extra origins allowed to call the relayer
# CASCADE_FEE_BPS=50               # Cascade fee, 0.5% (the published price), paid by customers
# CASCADE_FEE_RECIPIENT=           # NEAR Intents account that receives it
# CASCADE_ADMIN_TOKEN=             # turns on /admin; generate with: openssl rand -hex 24 (never commit)
PORT=8788
TRUST_PROXY=0
SETTLER_INTERVAL_MS=5000
CASCADE_DB=.data/cascade.sqlite
