# Copy to .env and fill in. Never commit .env.
# `pnpm demo` and `pnpm test` need NONE of these.

NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# Contracts (set after deployment; nothing is deployed yet)
CASCADE_APP_ID=app.cascade.near
CASCADE_FACTORY_ID=cascade.near
USDC_CONTRACT_ID=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
SPUTNIK_FACTORY_ID=sputnik-dao.near

# 1Click partner JWT from https://partners.near-intents.org (server only).
# Without it 1Click adds 0.2% per swap and refuses confidential (private) quotes.
ONECLICK_JWT=

# Relayer: pays gas for users. Must match the factory's `relayer`.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
RELAYER_PORT=8787
TRUST_PROXY=0

# Settler: the only account allowed to mark invoices paid.
SETTLER_ACCOUNT_ID=
SETTLER_PRIVATE_KEY=
SETTLER_INTERVAL_MS=5000
CASCADE_DB=.data/cascade.sqlite
